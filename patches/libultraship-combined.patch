+bool SDLButtonToAnyMapping::IsButtonPressed(SDL_GameController* gamepad) const {
+    if (!gamepad || !SDL_GameControllerGetAttached(gamepad)) return false;
+    if (mControllerButton >= RAW_JOYSTICK_BUTTON_BASE) {
+        auto* joystick = SDL_GameControllerGetJoystick(gamepad);
+        const int32_t button = mControllerButton - RAW_JOYSTICK_BUTTON_BASE;
+        return joystick && button < SDL_JoystickNumButtons(joystick) && SDL_JoystickGetButton(joystick, button);
+    }
+    return mControllerButton >= SDL_CONTROLLER_BUTTON_A && mControllerButton < SDL_CONTROLLER_BUTTON_MAX &&
+        SDL_GameControllerGetButton(gamepad, static_cast<SDL_GameControllerButton>(mControllerButton));
+}
+
+int32_t SDLButtonToAnyMapping::FindPressedUnmappedButton(SDL_GameController* gamepad) {
+    if (!gamepad || !SDL_GameControllerGetAttached(gamepad)) return -1;
+    auto* joystick = SDL_GameControllerGetJoystick(gamepad);
+    if (!joystick) return -1;
+    for (int32_t button = 0; button < SDL_JoystickNumButtons(joystick); ++button) {
+        if (!SDL_JoystickGetButton(joystick, button)) continue;
+        bool mapped = false;
+        for (int standard = SDL_CONTROLLER_BUTTON_A; standard < SDL_CONTROLLER_BUTTON_MAX; ++standard) {
+            const auto bind = SDL_GameControllerGetBindForButton(gamepad, static_cast<SDL_GameControllerButton>(standard));
+            if (bind.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON && bind.value.button == button) { mapped = true; break; }
+        }
+        if (mapped) continue;
+        for (int axis = SDL_CONTROLLER_AXIS_LEFTX; axis < SDL_CONTROLLER_AXIS_MAX; ++axis) {
+            const auto bind = SDL_GameControllerGetBindForAxis(gamepad, static_cast<SDL_GameControllerAxis>(axis));
+            if (bind.bindType == SDL_CONTROLLER_BINDTYPE_BUTTON && bind.value.button == button) { mapped = true; break; }
+        }
+        // GameCube digital trigger clicks are raw buttons 10/11 in SDL2's
+        // adapter driver, omitted from its standard game-controller mapping.
+        if (!mapped) return RAW_JOYSTICK_BUTTON_BASE + button;
+    }
+    return -1;
+}
