+bool ControllerStick::SaveCalibration(float centerX, float centerY,
+                                     const std::array<float, CALIBRATION_SAMPLES>& radii) {
+    if (!std::isfinite(centerX) || !std::isfinite(centerY) || std::abs(centerX) > MAX_AXIS_RANGE * .25f ||
+        std::abs(centerY) > MAX_AXIS_RANGE * .25f) return false;
+    for (float radius : radii)
+        if (!std::isfinite(radius) || radius < MAX_AXIS_RANGE * .25f || radius > MAX_AXIS_RANGE * 2.f) return false;
+    mCalibrationCenterX = centerX; mCalibrationCenterY = centerY;
+    mCalibrationRadii = radii; mCalibrated = true;
