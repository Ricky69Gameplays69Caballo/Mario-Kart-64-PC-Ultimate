+    const auto prefix = StringHelper::Sprintf(CVAR_PREFIX_CONTROLLERS ".Port%d.%s.Calibration",
+        mPortIndex + 1, stickIndexToConfigStickIndexName[mStickIndex].c_str());
+    vars->SetInteger((prefix + ".Enabled").c_str(), 1);
+    vars->SetFloat((prefix + ".CenterX").c_str(), centerX);
+    vars->SetFloat((prefix + ".CenterY").c_str(), centerY);
+    for (size_t i = 0; i < CALIBRATION_SAMPLES; ++i)
+        vars->SetFloat((prefix + ".Radius" + std::to_string(i)).c_str(), radii[i]);
+    vars->Save();
+    return true;
+}
