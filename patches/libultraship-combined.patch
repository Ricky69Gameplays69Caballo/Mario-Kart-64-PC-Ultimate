+void ConnectedPhysicalDeviceManager::LoadAssignments() {
+    if (mAssignmentsLoaded) return;
+    mAssignmentsLoaded = true;
+    const auto root = Context::GetRawInstance()->GetConfig()->GetNestedJson();
+    if (!root.contains("ControllerDeviceAssignments")) return;
+    const auto& block = root["ControllerDeviceAssignments"];
+    if (!block.is_object() || !block.contains("Devices") || !block["Devices"].is_array()) return;
+    for (const auto& device : block["Devices"]) {
+        if (!device.is_object() || !device.contains("Key") || !device["Key"].is_string() ||
+            !device.contains("IgnoredPorts") || !device["IgnoredPorts"].is_number_unsigned()) continue;
+        const auto mask = device["IgnoredPorts"].get<uint64_t>();
+        if (mask <= 0xFFFFu) mRememberedIgnoredPorts[device["Key"].get<std::string>()] = uint16_t(mask);
+    }
+}
+
+void ConnectedPhysicalDeviceManager::SaveAssignments() {
+    nlohmann::json devices = nlohmann::json::array();
+    for (const auto& [key, mask] : mRememberedIgnoredPorts)
+        devices.push_back({{"Key", key}, {"IgnoredPorts", mask}});
+    Context::GetRawInstance()->GetConfig()->SetBlock("ControllerDeviceAssignments",
+        {{"Version", 1}, {"Devices", devices}});
+}
+
+void ConnectedPhysicalDeviceManager::ApplyAssignments() {
+    mIgnoredInstanceIds.clear();
+    for (const auto& [instance, key] : mDeviceKeys)
+        for (uint8_t port = 0; port < 16; ++port)
+            if (mRememberedIgnoredPorts.at(key) & (1u << port)) mIgnoredInstanceIds[port].insert(instance);
+    RebuildGamepadsForAllPorts();
+}
+
+std::vector<std::string> ConnectedPhysicalDeviceManager::GetEnabledDeviceKeysForPort(uint8_t portIndex) {
+    LoadAssignments();
+    std::vector<std::string> keys;
+    if (portIndex < 16)
+        for (const auto& [instance, key] : mDeviceKeys)
+            if (!PortIsIgnoringInstanceId(portIndex, instance)) keys.push_back(key);
+    return keys;
+}
+
+void ConnectedPhysicalDeviceManager::SetEnabledDeviceKeysForPort(uint8_t portIndex,
+                                                              const std::vector<std::string>& keys) {
+    if (portIndex >= 16) return;
+    LoadAssignments();
+    for (auto& [key, mask] : mRememberedIgnoredPorts) mask |= uint16_t(1u << portIndex);
+    for (const auto& key : keys) {
+        auto [it, inserted] = mRememberedIgnoredPorts.try_emplace(key, 0xFFFFu);
+        it->second &= uint16_t(~(1u << portIndex));
+    }
+    ApplyAssignments();
+    SaveAssignments();
 }
 
