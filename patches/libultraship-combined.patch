+// Keep each concurrently running game in its own writable profile. Asset and
+// mod paths still resolve to the installation so they are shared read-only.
+static unsigned int GetGameInstanceSlot(const std::filesystem::path& appDirectory) {
+    static const unsigned int slot = [&]() {
+        const auto lockDirectory = appDirectory / "instance-locks";
+        std::error_code error;
+        std::filesystem::create_directories(lockDirectory, error);
+        if (error) throw std::runtime_error("Cannot create game instance lock directory");
+        for (unsigned int index = 0; index < 128; ++index) {
+            const auto lockPath = lockDirectory / (std::to_string(index) + ".lock");
+#ifdef _WIN32
+            // Holding an exclusive handle reserves this slot until process exit,
+            // including after a crash. Lock files themselves can remain on disk.
+            HANDLE handle = CreateFileW(lockPath.c_str(), GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+                                        OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (handle != INVALID_HANDLE_VALUE) return index;
+            const DWORD lockError = GetLastError();
+            if (lockError != ERROR_SHARING_VIOLATION && lockError != ERROR_LOCK_VIOLATION)
+                throw std::runtime_error("Cannot open game instance lock");
+#else
+            int fd = open(lockPath.c_str(), O_CREAT | O_RDWR, 0600);
+            if (fd < 0) throw std::runtime_error("Cannot open game instance lock");
+            if (flock(fd, LOCK_EX | LOCK_NB) == 0) return index;
+            close(fd);
+#endif
+        }
+        throw std::runtime_error("Too many game instances are running");
+    }();
+    return slot;
+}
+
 std::string Context::GetPathRelativeToAppDirectory(const std::string& path, const std::string& appName) {
-    return GetAppDirectoryPath(appName) + "/" + path;
+    const std::filesystem::path appDirectory = GetAppDirectoryPath(appName);
+    const bool mutableFile = path == "spaghettify.cfg.json" || path == "default.sav" ||
+        path == "imgui.ini" || path == "imgui_log.txt" || path == "cvars.cfg" ||
+        path.rfind("controllerPak_", 0) == 0 || path == "logs" || path.rfind("logs/", 0) == 0;
+    if (!mutableFile) return (appDirectory / path).string();
+
+    const unsigned int slot = GetGameInstanceSlot(appDirectory);
+    if (slot == 0) return (appDirectory / path).string();
+
+    const auto profile = appDirectory / "instances" / std::to_string(slot + 1);
+    const auto target = profile / path;
+    std::error_code error;
+    std::filesystem::create_directories(path == "logs" ? target : target.parent_path(), error);
+    if (error) throw std::runtime_error("Cannot create game instance data directory");
+    // On first use, inherit the main profile's settings and progress. After
+    // that, each instance owns its copy and never overwrites another's data.
+    if (path != "logs" && path.rfind("logs/", 0) != 0 && !std::filesystem::exists(target)) {
+        const auto source = appDirectory / path;
+        if (std::filesystem::is_regular_file(source)) {
+            std::filesystem::copy_file(source, target, std::filesystem::copy_options::skip_existing, error);
+            if (error) throw std::runtime_error("Cannot initialize game instance data");
+        }
+    }
+    return target.string();
 }
 
